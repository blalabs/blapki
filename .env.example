# Copy to .env and fill in. Loaded automatically at startup.

# Static-challenge secret for the "test" SCEP profile.
BLAPKI_TEST_CHALLENGE=change-me

# Intune app registration secret (only if a profile uses challenge = "intune").
# BLAPKI_INTUNE_CLIENT_SECRET=

# Password for an encrypted CA key file (only if key_password_env is set).
# BLAPKI_CA_DEFAULT_PASSWORD=

# Optional: override config values, e.g.
# BLAPKI_CONFIG=/app/config.toml
# BLAPKI_SERVER__LISTEN=0.0.0.0:8080
